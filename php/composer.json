{
    "name": "gsoultan/panmail-sdk",
    "description": "PHP client for sending mail through a panmail gateway",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Panmail\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Panmail\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "analyse": [
            "phpstan analyse -c phpstan.neon --no-progress --memory-limit=1G",
            "phpstan analyse -c phpstan-tests.neon --no-progress --memory-limit=1G"
        ]
    }
}
