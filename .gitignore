/vendor/

# PHP
php/vendor/
php/.phpunit.result.cache
# A library pins nothing: the lock files are not part of what is published.
php/composer.lock
/composer.lock

# Java
java/target/

# Node
node/node_modules/
node/dist/
# bun.lock is committed on purpose: CI installs with --frozen-lockfile, which
# without it silently resolves fresh versions on every run instead of failing.
