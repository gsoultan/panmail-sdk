# Go, and composer's install at the root, which lands in the same place.
/vendor/

# PHP
php/vendor/
php/.phpunit.result.cache
# A library pins nothing: the lock files are not part of what is published.
php/composer.lock
/composer.lock

# Coverage artefacts
coverage.out
php/coverage.xml

# graphify's build state rather than its graph: file mtimes, the absolute path
# of whoever ran it, and a stamp that moves on every query. The graph, its
# analysis and its report are committed; this would only churn, and be wrong
# on any other machine.
graphify-out/cache/
graphify-out/manifest.json
graphify-out/.graphify_root
